{
  "archiveDoneAfter": "7d",
  "worktreesDir": ".claude/worktrees",
  "columns": [
    {
      "id": "todo",
      "name": "Sessions",
      "role": "todo",
      "color": "#6b7280"
    },
    {
      "id": "planning",
      "name": "Planning",
      "color": "#8b5cf6",
      "autoSpawn": true,
      "permissionMode": "plan",
      "planExitTarget": "Executing"
    },
    {
      "id": "executing",
      "name": "Executing",
      "color": "#3b82f6",
      "autoSpawn": true
    },
    {
      "id": "self-review",
      "name": "Waiting for me",
      "color": "#06b6d4",
      "autoSpawn": true
    },
    {
      "id": "in-review",
      "name": "In review",
      "color": "#f59e0b",
      "autoSpawn": true,
      "automations": {
        "onEnter": [
          {
            "name": "Remove extra comments",
            "type": "send_message",
            "message": "Run comment-destroyer subagent"
          },
          {
            "name": "Simplify",
            "type": "send_message",
            "message": "/simplify"
          },
          {
            "name": "Review",
            "type": "send_message",
            "message": "/pr-review-toolkit:review-pr"
          },
          {
            "name": "Build",
            "type": "run_script",
            "script": "go build ./... && go vet ./..."
          },
          {
            "name": "Ping",
            "type": "notify",
            "title": "{{title}}",
            "body": "PR #{{prNumber}} is in review"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Apply fixes",
            "type": "send_message",
            "message": "Apply the fixes the review found, then run go test ./...",
            "condition": "The message says a specific review finding is still open and the agent will fix it. Answer NO if it says nothing is left to apply, or lists findings only as skipped, declined, deferred or already fixed"
          }
        ]
      }
    },
    {
      "id": "done",
      "name": "Done",
      "role": "done",
      "color": "#10b981"
    }
  ],
  "prFlow": {
    "requested": "self-review",
    "opened": "in-review",
    "changesRequested": "executing",
    "changesRequestedMessage": "PR #{{prNumber}} ({{prUrl}}) got review comments. Read them with `gh pr view {{prUrl}} --comments` and the inline ones with `gh api repos/{owner}/{repo}/pulls/{{prNumber}}/comments`, address them, push, and reply to each.",
    "merged": "done"
  }
}
