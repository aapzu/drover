{
  "archiveDoneAfter": "7d",
  "worktreesDir": ".claude/worktrees",
  "columns": [
    {
      "id": "planning",
      "name": "Planning",
      "color": "#8b5cf6",
      "autoSpawn": true,
      "permissionMode": "plan",
      "planExitTarget": "Executing",
      "noWorktree": true
    },
    {
      "id": "executing",
      "name": "Executing",
      "color": "#3b82f6",
      "autoSpawn": true
    },
    {
      "id": "waiting-for-me",
      "name": "Waiting for me",
      "color": "#06b6d4",
      "autoSpawn": true
    },
    {
      "id": "in-review",
      "name": "In review",
      "color": "#f59e0b",
      "autoSpawn": true,
      "automations": {
        "onEnter": [
          {
            "name": "Ping",
            "type": "notify",
            "title": "{{title}}",
            "body": "PR #{{prNumber}} is in review"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Fix conflicts",
            "type": "send_message",
            "message": "PR #{{prNumber}} has merge conflicts with its base branch. Fetch the base branch, merge it into this branch, resolve the conflicts, run go build ./... and go test ./..., then push (no force push).",
            "conditionScript": "test -n \"$DROVER_PRNUMBER\" && test \"$(gh pr view \"$DROVER_PRNUMBER\" --json mergeable --jq .mergeable)\" = CONFLICTING"
          },
          {
            "name": "Apply fixes",
            "type": "send_message",
            "message": "Apply the fixes the review found, then run go test ./...",
            "condition": "The message lists at least one specific review finding that is still open. Answer NO if it says nothing is left to apply, or lists findings only as skipped, declined, deferred or already fixed"
          },
          {
            "name": "Open PR",
            "type": "send_message",
            "message": "Commit the changes, push the branch and open the PR with gh pr create, then watch its checks.",
            "condition": "The message is a reply to the code review or to applying its fixes, and lists no review findings left to fix. Missing tests and uncommitted changes don't count as findings",
            "conditionScript": "test -z \"$DROVER_PRNUMBER\""
          }
        ]
      }
    },
    {
      "id": "done",
      "name": "Done",
      "role": "done",
      "color": "#10b981"
    },
    {
      "id": "review-requested",
      "name": "Review requested",
      "lane": "review",
      "color": "#a855f7"
    },
    {
      "id": "reviewing",
      "name": "Reviewing",
      "lane": "review",
      "color": "#ec4899",
      "autoSpawn": true,
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Re-review",
            "type": "send_message",
            "message": "Review PR #{{prNumber}} ({{prUrl}}) again. Look only at what changed since your last review, and list what is still open.",
            "conditionScript": "test -n \"$DROVER_PRREVIEWEDSHA\""
          }
        ],
        "onTurnEnd": [
          {
            "name": "Triage",
            "type": "move_to_column",
            "targetColumn": "triage",
            "conditionScript": "test -n \"$DROVER_PRREVIEWEDSHA\""
          }
        ]
      }
    },
    {
      "id": "triage",
      "name": "Triage findings",
      "lane": "review",
      "color": "#f97316",
      "autoSpawn": true
    },
    {
      "id": "waiting-on-author",
      "name": "Waiting on author",
      "lane": "review",
      "color": "#64748b"
    },
    {
      "id": "review-done",
      "name": "Done",
      "role": "done",
      "lane": "review",
      "color": "#10b981"
    }
  ],
  "prFlow": {
    "requested": "waiting-for-me",
    "opened": "in-review",
    "changesRequested": "executing",
    "changesRequestedMode": "propose",
    "merged": "done"
  },
  "reviewFlow": {
    "requested": "review-requested",
    "started": "triage",
    "reviewed": "waiting-on-author",
    "approved": "review-done",
    "updated": "reviewing",
    "done": "review-done"
  }
}
